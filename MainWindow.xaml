<Window x:Class="TankManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TankManager"
        xmlns:models="clr-namespace:TankManager.Core.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Tank Manager v1.1.5"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="FileDropZone_Drop"
        DragEnter="FileDropZone_DragEnter"
        FontFamily="Segoe UI"
        FontSize="12"
        Foreground="{StaticResource TextPrimary}"
        Background="{StaticResource WindowBackground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:GroupCountToVisibilityConverter x:Key="GroupCountToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
        <local:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter"/>
        <local:DoubleNonZeroToVisibilityConverter x:Key="DoubleNonZeroToVisibilityConverter"/>
        <local:GroupItemPropertyConverter x:Key="GroupItemPropertyConverter"/>
        <local:MaterialSortTypeConverter x:Key="MaterialSortTypeConverter"/>

        <!-- ObjectDataProvider для MaterialSortType enum -->
        <ObjectDataProvider x:Key="SheetMaterialSortOptions" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:MaterialSortType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Storyboard для анимации SnackBar -->
        <Storyboard x:Key="ShowSnackbarStoryboard">
            <DoubleAnimation Storyboard.TargetName="SnackbarNotification"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                           From="100" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SnackbarNotification"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="HideSnackbarStoryboard">
            <DoubleAnimation Storyboard.TargetName="SnackbarNotification"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                           To="100" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SnackbarNotification"
                           Storyboard.TargetProperty="Opacity"
                           To="0" Duration="0:0:0.2"/>
        </Storyboard>

        <!-- Storyboard для анимации панели продуктов -->
        <Storyboard x:Key="ShowProductsPanelStoryboard">
            <DoubleAnimation Storyboard.TargetName="ProductsPanel"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                           From="-320" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ProductsPanelOverlay"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="HideProductsPanelStoryboard">
            <DoubleAnimation Storyboard.TargetName="ProductsPanel"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                           To="-320" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ProductsPanelOverlay"
                           Storyboard.TargetProperty="Opacity"
                           To="0" Duration="0:0:0.25"/>
        </Storyboard>

        <!-- Свойства: подпись и значение -->
        <Style TargetType="TextBlock" x:Key="PropertyLabel">
            <Setter Property="Margin" Value="0,4,16,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="PropertyValue">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="TotalValue" BasedOn="{StaticResource PropertyValue}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="CaptionText">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Кнопка-иконка в заголовках карточек -->
        <Style x:Key="CopyButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButton}"/>

        <!-- Кнопка тулбара / панели -->
        <Style x:Key="PanelButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Превью (модель / чертёж) -->
        <Style x:Key="PreviewBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- Стиль для ComboBox сортировки -->
        <Style x:Key="SortComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                             Focusable="False"
                                             IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                             ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent">
                                                <TextBlock Text="&#xE70D;"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="9"
                                                           Margin="0,0,8,0"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondary}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite"
                                                 Content="{TemplateBinding SelectionBoxItem}"
                                                 ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                 ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                 Margin="6,4,20,4"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 IsHitTestVisible="False"/>
                                <Popup x:Name="Popup"
                                      Placement="Bottom"
                                      IsOpen="{TemplateBinding IsDropDownOpen}"
                                      AllowsTransparency="True"
                                      Focusable="False"
                                      PopupAnimation="Fade">
                                    <Border Background="{StaticResource PrimaryBackground}"
                                           BorderBrush="{StaticResource BorderColor}"
                                           BorderThickness="1"
                                           CornerRadius="6"
                                           Padding="4"
                                           Margin="6,4,6,10"
                                           MinWidth="{Binding ActualWidth, ElementName=Bd}"
                                           Effect="{StaticResource SoftShadow}">
                                        <ScrollViewer MaxHeight="200">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentSubtle}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Общий шаблон для списка деталей с группировкой -->
        <DataTemplate x:Key="PartItemTemplate">
            <StackPanel Cursor="Hand">
                <TextBlock FontSize="12" TextWrapping="Wrap">
                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="{Binding Marking, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding DetailType}"/>
                    <Run Text="·"/>
                    <Run Text="{Binding Material}"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- Стиль для элементов списка -->
        <Style x:Key="PartListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBackground}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedBackground}"/>
                    <Setter Property="Foreground" Value="{StaticResource SelectedForeground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для элементов материалов -->
        <Style x:Key="MaterialListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource PartListBoxItemStyle}"/>

        <!-- Раскрывающаяся группа одинаковых деталей -->
        <Style x:Key="GroupExpanderStyle" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          HorizontalContentAlignment="Stretch"
                                          FocusVisualStyle="{x:Null}"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Chevron"
                                                           Text="&#xE76C;"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="9"
                                                           Margin="0,4,8,0"
                                                           VerticalAlignment="Top"
                                                           Foreground="{StaticResource TextSecondary}"/>
                                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Stretch"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBackground}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль группировки -->
        <Style x:Key="GroupedContainerStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Grid>
                            <Expander IsExpanded="False"
                                      Style="{StaticResource GroupExpanderStyle}"
                                      Margin="0,1"
                                      Visibility="{Binding ItemCount, Converter={StaticResource GroupCountToVisibilityConverter}, ConverterParameter=Multiple}">
                                <Expander.Header>
                                    <Grid Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}">
                                                <Run FontWeight="SemiBold" Text="{Binding Converter={StaticResource GroupItemPropertyConverter}, ConverterParameter=Name, Mode=OneWay}"/>
                                                <Run Text="{Binding Converter={StaticResource GroupItemPropertyConverter}, ConverterParameter=Marking, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Converter={StaticResource GroupItemPropertyConverter}, ConverterParameter=DetailType, Mode=OneWay}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding Converter={StaticResource GroupItemPropertyConverter}, ConverterParameter=Material, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="{StaticResource AccentSubtle}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} шт.'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentColor}"/>
                                        </Border>
                                    </Grid>
                                </Expander.Header>
                                <Border Margin="16,0,0,4" Padding="8,0,0,0" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0">
                                    <ItemsPresenter/>
                                </Border>
                            </Expander>

                            <ItemsPresenter Visibility="{Binding ItemCount, Converter={StaticResource GroupCountToVisibilityConverter}, ConverterParameter=Single}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Операции изготовления: общие стили -->
        <Style x:Key="OperationCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="OperationTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="OperationParam" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="OperationCost" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>

        <!-- DataTemplates для операций изготовления -->
        <DataTemplate DataType="{x:Type models:BendingOperation}">
            <Border Style="{StaticResource OperationCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Гибка" Style="{StaticResource OperationTitle}"/>
                    <WrapPanel Grid.Row="1">
                        <TextBlock Style="{StaticResource OperationParam}">
                            <Run Text="Угол: "/><Run Text="{Binding BendAngle, StringFormat='{}{0:F1}°'}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource OperationParam}"
                                   Visibility="{Binding BendLength, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}">
                            <Run Text="Длина: "/><Run Text="{Binding BendLength, StringFormat='{}{0:F1} мм'}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource OperationParam}"
                                   Visibility="{Binding MaterialThickness, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}">
                            <Run Text="Толщина: "/><Run Text="{Binding MaterialThickness, StringFormat='{}{0:F1} мм'}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource OperationParam}"
                                   Visibility="{Binding TimeMinutes, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}">
                            <Run Text="Время: "/><Run Text="{Binding TimeMinutes, StringFormat='{}{0:F1} мин'}"/>
                        </TextBlock>
                    </WrapPanel>
                    <TextBlock Grid.Column="1" Grid.RowSpan="2"
                               Style="{StaticResource OperationCost}"
                               Text="{Binding Cost, StringFormat='{}{0:F2} ₽'}"
                               Visibility="{Binding Cost, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:FlangingOperation}">
            <Border Style="{StaticResource OperationCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Отбортовка" Style="{StaticResource OperationTitle}"/>
                    <WrapPanel Grid.Row="1">
                        <TextBlock Style="{StaticResource OperationParam}"
                                   Visibility="{Binding Radius, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}">
                            <Run Text="Радиус: "/><Run Text="{Binding Radius, StringFormat='{}{0:F1} мм'}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource OperationParam}"
                                   Visibility="{Binding Diameter, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}">
                            <Run Text="Ø: "/><Run Text="{Binding Diameter, StringFormat='{}{0:F1} мм'}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource OperationParam}"
                                   Visibility="{Binding MaterialThickness, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}">
                            <Run Text="Толщина: "/><Run Text="{Binding MaterialThickness, StringFormat='{}{0:F1} мм'}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource OperationParam}"
                                   Visibility="{Binding TimeMinutes, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}">
                            <Run Text="Время: "/><Run Text="{Binding TimeMinutes, StringFormat='{}{0:F1} мин'}"/>
                        </TextBlock>
                    </WrapPanel>
                    <TextBlock Grid.Column="1" Grid.RowSpan="2"
                               Style="{StaticResource OperationCost}"
                               Text="{Binding Cost, StringFormat='{}{0:F2} ₽'}"
                               Visibility="{Binding Cost, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:RollingOperation}">
            <Border Style="{StaticResource OperationCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Вальцовка" Style="{StaticResource OperationTitle}"/>
                    <WrapPanel Grid.Row="1">
                        <TextBlock Style="{StaticResource OperationParam}"
                                   Visibility="{Binding Length, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}">
                            <Run Text="Длина: "/><Run Text="{Binding Length, StringFormat='{}{0:F1} мм'}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource OperationParam}"
                                   Visibility="{Binding RollDiameter, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}">
                            <Run Text="Ø: "/><Run Text="{Binding RollDiameter, StringFormat='{}{0:F1} мм'}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource OperationParam}"
                                   Visibility="{Binding Radius, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}">
                            <Run Text="Радиус: "/><Run Text="{Binding Radius, StringFormat='{}{0:F1} мм'}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource OperationParam}"
                                   Visibility="{Binding MaterialThickness, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}">
                            <Run Text="Толщина: "/><Run Text="{Binding MaterialThickness, StringFormat='{}{0:F1} мм'}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource OperationParam}"
                                   Visibility="{Binding TimeMinutes, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}">
                            <Run Text="Время: "/><Run Text="{Binding TimeMinutes, StringFormat='{}{0:F1} мин'}"/>
                        </TextBlock>
                    </WrapPanel>
                    <TextBlock Grid.Column="1" Grid.RowSpan="2"
                               Style="{StaticResource OperationCost}"
                               Text="{Binding Cost, StringFormat='{}{0:F2} ₽'}"
                               Visibility="{Binding Cost, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:LaserCuttingOperation}">
            <Border Style="{StaticResource OperationCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Резка на лазере" Style="{StaticResource OperationTitle}"/>
                    <WrapPanel Grid.Row="1">
                        <TextBlock Style="{StaticResource OperationParam}">
                            <Run Text="Рез: "/><Run Text="{Binding CutLength, StringFormat='{}{0:F1} мм'}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource OperationParam}"
                                   Visibility="{Binding EngravingLength, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}">
                            <Run Text="Гравировка: "/><Run Text="{Binding EngravingLength, StringFormat='{}{0:F1} мм'}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource OperationParam}"
                                   Visibility="{Binding MaterialThickness, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}">
                            <Run Text="Толщина: "/><Run Text="{Binding MaterialThickness, StringFormat='{}{0:F1} мм'}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource OperationParam}"
                                   Visibility="{Binding TimeMinutes, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}">
                            <Run Text="Время: "/><Run Text="{Binding TimeMinutes, StringFormat='{}{0:F1} мин'}"/>
                        </TextBlock>
                    </WrapPanel>
                    <TextBlock Grid.Column="1" Grid.RowSpan="2"
                               Style="{StaticResource OperationCost}"
                               Text="{Binding Cost, StringFormat='{}{0:F2} ₽'}"
                               Visibility="{Binding Cost, Converter={StaticResource DoubleNonZeroToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ToggleProductsPanelCommand}"
                            Style="{StaticResource PanelButtonStyle}"
                            ToolTip="Список сохранённых изделий">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE700;" Style="{StaticResource IconText}" Margin="0,0,8,0"/>
                            <TextBlock Text="Изделия"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="20" Fill="{StaticResource BorderColor}" Margin="6,0"/>

                    <Button x:Name="LoadDocumentButton"
                            Click="LoadDocumentButton_Click"
                            Style="{StaticResource PanelButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" Style="{StaticResource IconText}" Margin="0,0,8,0"/>
                            <TextBlock Text="Загрузить"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SaveProductCommand}"
                            ToolTipService.ShowOnDisabled="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLinkedToKompas}" Value="True">
                                        <Setter Property="ToolTip" Value="Сохранить текущее изделие"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLinkedToKompas}" Value="False">
                                        <Setter Property="ToolTip" Value="Для сохранения необходима связь с КОМПАС"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource IconText}" Margin="0,0,8,0"/>
                            <TextBlock Text="Сохранить"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="20" Fill="{StaticResource BorderColor}" Margin="6,0"/>

                    <Button Command="{Binding CopyAllDataToClipboardCommand}"
                            Style="{StaticResource PanelButtonStyle}"
                            ToolTip="Копировать покупные детали, листовые и трубные материалы в Excel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" Margin="0,0,8,0"/>
                            <TextBlock Text="Копировать всё"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportToExcelCommand}"
                            Style="{StaticResource PanelButtonStyle}"
                            ToolTip="Сохранить ведомость материалов в Excel файл">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" Style="{StaticResource IconText}" Margin="0,0,8,0"/>
                            <TextBlock Text="Ведомость в Excel"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="20" Fill="{StaticResource BorderColor}" Margin="6,0"/>

                    <Button Command="{Binding OpenPricingSettingsCommand}"
                            Style="{StaticResource PanelButtonStyle}"
                            ToolTip="Настроить расценки для расчёта стоимости деталей">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource IconText}" Margin="0,0,8,0"/>
                            <TextBlock Text="Цены"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Кнопка связи с КОМПАС / индикатор статуса -->
                    <Button Command="{Binding LinkToKompasCommand}"
                            ToolTip="Установить связь с КОМПАС"
                            Padding="12,5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Setter Property="Background" Value="{StaticResource WarningSubtle}"/>
                                <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFFEF3C7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Visibility>
                            <Binding Path="IsLinkedToKompas">
                                <Binding.Converter>
                                    <local:InverseBooleanToVisibilityConverter/>
                                </Binding.Converter>
                            </Binding>
                        </Button.Visibility>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Warning}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Связать с КОМПАС" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Border Visibility="{Binding IsLinkedToKompas, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{StaticResource SuccessSubtle}"
                            CornerRadius="6"
                            Padding="12,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Success}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Связан с КОМПАС" Foreground="{StaticResource Success}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Command="{Binding RefreshFromKompasCommand}"
                                    Style="{StaticResource IconButton}"
                                    Foreground="{StaticResource Success}"
                                    Content="&#xE72C;"
                                    ToolTip="Обновить данные из КОМПАС"/>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding CheckForUpdatesCommand}"
                            Style="{StaticResource IconButton}"
                            Content="&#xE895;"
                            Width="32" Height="32"
                            Margin="8,0,0,0"
                            ToolTip="Проверить наличие обновлений"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент с выдвижной панелью поверх -->
        <Grid Grid.Row="1">
            <!-- Основной контент -->
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="250"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2.5*" MinWidth="250"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <!-- ЛЕВАЯ ПАНЕЛЬ: Список всех деталей -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="2,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Все детали" Style="{StaticResource SectionHeaderStyle}"/>
                            <Button Grid.Column="1"
                                    Content="&#xE8C8;"
                                    Style="{StaticResource CopyButtonStyle}"
                                    Command="{Binding CopyAllToClipboardCommand}"
                                    ToolTip="Копировать в Excel"/>
                        </Grid>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Головное изделие -->
                            <Border Grid.Row="0"
                                    Padding="10,8"
                                    Margin="0,0,0,8"
                                    CornerRadius="8"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="ProductHeader_MouseLeftButtonDown"
                                    Visibility="{Binding CurrentProduct.Name, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource AccentSubtle}"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource SelectedBackground}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsProductSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="{StaticResource PrimaryBackground}"
                                            CornerRadius="6"
                                            Width="32" Height="32"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7B8;" Style="{StaticResource IconText}" FontSize="16" Foreground="{StaticResource AccentColor}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentProduct.Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding CurrentProduct.Marking}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,1,0,0"
                                                   Visibility="{Binding CurrentProduct.Marking, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding CurrentProduct.Mass, StringFormat='{}{0:F2} кг'}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentColor}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Поле поиска -->
                            <Border Grid.Row="1"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    Padding="8,5"
                                    Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SecondaryBackground}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBackground}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="&#xE721;"
                                               Style="{StaticResource IconText}"
                                               FontSize="12"
                                               Margin="0,0,8,0"
                                               Foreground="{StaticResource TextMuted}"/>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             VerticalAlignment="Center"
                                             FontSize="12"
                                             Foreground="{StaticResource TextPrimary}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                                    <VisualBrush.Visual>
                                                                        <TextBlock Text="Поиск деталей"
                                                                                   Foreground="{StaticResource TextMuted}"
                                                                                   FontFamily="Segoe UI"
                                                                                   FontSize="12"/>
                                                                    </VisualBrush.Visual>
                                                                </VisualBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <Button Grid.Column="2"
                                            Content="&#xE711;"
                                            Style="{StaticResource IconButton}"
                                            Width="20" Height="20"
                                            FontSize="9"
                                            Margin="4,0,0,0"
                                            ToolTip="Очистить"
                                            Command="{Binding ClearSearchCommand}"
                                            Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <!-- Индикатор активного фильтра -->
                            <Border Grid.Row="2"
                                    Background="{StaticResource AccentSubtle}"
                                    CornerRadius="6"
                                    Padding="10,2,2,2"
                                    Margin="0,0,0,8"
                                    Visibility="{Binding SelectedMaterialFilter, Converter={StaticResource InverseNullToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE71C;" Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource AccentColor}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedMaterialFilter.Name}"
                                               FontSize="11"
                                               Foreground="{StaticResource SelectedForeground}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2"
                                            Content="&#xE711;"
                                            Style="{StaticResource IconButton}"
                                            Width="22" Height="22"
                                            FontSize="9"
                                            Foreground="{StaticResource AccentColor}"
                                            ToolTip="Сбросить фильтр"
                                            Click="ClearFilter_Click"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="3" x:Name="Список_всех_деталей"
                                     ItemsSource="{Binding DetailsView}"
                                     SelectedItem="{Binding SelectedDetail}"
                                     ItemTemplate="{StaticResource PartItemTemplate}"
                                     ItemContainerStyle="{StaticResource PartListBoxItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0">
                                <ListBox.GroupStyle>
                                    <GroupStyle ContainerStyle="{StaticResource GroupedContainerStyle}"/>
                                </ListBox.GroupStyle>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                <!-- ЦЕНТРАЛЬНАЯ ПАНЕЛЬ: Свойства выбранной детали / изделия -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16,10">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12" MinHeight="28">
                            <TextBlock Text="Свойства детали"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Visibility="{Binding DataContext.IsProductSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <TextBlock Text="Изделие"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Visibility="{Binding DataContext.IsProductSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <!-- Превью изделия когда ничего не выбрано -->
                                <Grid Visibility="{Binding DataContext.CurrentlySelectedPart, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                HorizontalAlignment="Center"
                                                Margin="0,48,0,0"
                                                Visibility="{Binding DataContext.CurrentProduct.FilePreview, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="&#xE8FD;" Style="{StaticResource IconText}" FontSize="28" Foreground="{StaticResource BorderColor}" Margin="0,0,0,10"/>
                                        <TextBlock Text="Выберите деталь из списка"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="12"/>
                                    </StackPanel>

                                    <!-- Превью файла изделия -->
                                    <Border Grid.Row="1"
                                            Style="{StaticResource PreviewBoxStyle}"
                                            Padding="16"
                                            VerticalAlignment="Top"
                                            Visibility="{Binding DataContext.CurrentProduct.FilePreview, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseNullToVisibilityConverter}}">
                                        <Image Source="{Binding DataContext.CurrentProduct.FilePreview, RelativeSource={RelativeSource AncestorType=Window}}"
                                               MaxHeight="400"
                                               Stretch="Uniform"
                                               StretchDirection="DownOnly"
                                               HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Карточка сводки изделия при выборе баннера -->
                                <Grid Visibility="{Binding DataContext.IsProductSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Background="{StaticResource PrimaryBackground}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Превью изделия -->
                                    <Border Grid.Row="0"
                                            Style="{StaticResource PreviewBoxStyle}"
                                            Margin="0,0,0,12"
                                            VerticalAlignment="Top"
                                            Visibility="{Binding CurrentProduct.FilePreview, Converter={StaticResource InverseNullToVisibilityConverter}}">
                                        <Image Source="{Binding CurrentProduct.FilePreview}"
                                               MaxHeight="250"
                                               Stretch="Uniform"
                                               StretchDirection="DownOnly"
                                               HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- Свойства изделия -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Название" Style="{StaticResource PropertyLabel}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentProduct.Name}" Style="{StaticResource PropertyValue}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Обозначение" Style="{StaticResource PropertyLabel}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentProduct.Marking}" Style="{StaticResource PropertyValue}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Масса" Style="{StaticResource PropertyLabel}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentProduct.Mass, StringFormat='{}{0:F3} кг'}" Style="{StaticResource PropertyValue}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Деталей" Style="{StaticResource PropertyLabel}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentProduct.TotalPartsCount, StringFormat='{}{0} шт'}" Style="{StaticResource PropertyValue}"/>

                                        <Rectangle Grid.Row="4" Grid.ColumnSpan="2" Height="1" Fill="{StaticResource BorderColor}" Margin="0,8"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Стоимость" Style="{StaticResource PropertyLabel}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CurrentProduct.TotalAssemblyCost, StringFormat='{}{0:N2} ₽'}" Style="{StaticResource TotalValue}"/>
                                    </Grid>
                                </Grid>

                                <Grid Visibility="{Binding DataContext.CurrentlySelectedPart, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseNullToVisibilityConverter}}"
                                      DataContext="{Binding CurrentlySelectedPart}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Превью 3D модели + Чертёж детали (бок о бок) -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4*"/>
                                            <ColumnDefinition Width="6*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Превью 3D модели (слева, 40%) -->
                                        <Border Grid.Column="0"
                                                Style="{StaticResource PreviewBoxStyle}"
                                                Margin="0,0,4,0"
                                                Visibility="{Binding FilePreview, Converter={StaticResource InverseNullToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                                    <TextBlock Text="3D-модель" Style="{StaticResource CaptionText}"/>

                                                    <!-- Показать в КОМПАС -->
                                                    <Button Command="{Binding DataContext.ShowInKompasCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            IsEnabled="{Binding DataContext.IsLinkedToKompas, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Style="{StaticResource PrimaryButton}"
                                                            HorizontalAlignment="Right"
                                                            Padding="8,3"
                                                            FontSize="11"
                                                            ToolTip="Показать деталь в КОМПАС-3D">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE8A7;" Style="{StaticResource IconText}" FontSize="11" Margin="0,0,6,0"/>
                                                            <TextBlock Text="КОМПАС"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>

                                                <Image Grid.Row="1"
                                                       Source="{Binding FilePreview}"
                                                       MaxHeight="200"
                                                       Stretch="Uniform"
                                                       StretchDirection="DownOnly"
                                                       HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Чертёж детали (справа, 60%) -->
                                        <Border Grid.Column="1"
                                                Style="{StaticResource PreviewBoxStyle}"
                                                Margin="4,0,0,0"
                                                Visibility="{Binding DrawingPreview, Converter={StaticResource InverseNullToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,8" MinHeight="22">
                                                    <TextBlock Text="Чертёж" Style="{StaticResource CaptionText}"/>
                                                    <TextBlock Text="&#xE8A3;"
                                                               Style="{StaticResource IconText}"
                                                               FontSize="12"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{StaticResource TextMuted}"/>
                                                </Grid>

                                                <Border Grid.Row="1"
                                                        Background="Transparent"
                                                        Cursor="Hand"
                                                        ToolTip="Нажмите для увеличения"
                                                        MouseLeftButtonDown="DrawingPreview_MouseLeftButtonDown">
                                                    <Image Source="{Binding DrawingPreview}"
                                                           MaxHeight="200"
                                                           Stretch="Uniform"
                                                           StretchDirection="DownOnly"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Свойства детали -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Название" Style="{StaticResource PropertyLabel}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Style="{StaticResource PropertyValue}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Обозначение" Style="{StaticResource PropertyLabel}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Marking}" Style="{StaticResource PropertyValue}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Тип детали" Style="{StaticResource PropertyLabel}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailType}" Style="{StaticResource PropertyValue}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Тип продукта" Style="{StaticResource PropertyLabel}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProductType}" Style="{StaticResource PropertyValue}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Материал" Style="{StaticResource PropertyLabel}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Material}" Style="{StaticResource PropertyValue}"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Масса" Style="{StaticResource PropertyLabel}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Mass, StringFormat='{}{0:F3} кг'}" Style="{StaticResource PropertyValue}"/>

                                        <!-- Разделитель стоимости -->
                                        <Rectangle Grid.Row="6" Grid.ColumnSpan="2" Height="1" Fill="{StaticResource BorderColor}" Margin="0,8"/>

                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Металл" Style="{StaticResource PropertyLabel}"/>
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding MetalCost, StringFormat='{}{0:F2} руб'}" Style="{StaticResource PropertyValue}"/>

                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Операции" Style="{StaticResource PropertyLabel}"/>
                                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding OperationsCost, StringFormat='{}{0:F2} руб'}" Style="{StaticResource PropertyValue}"/>

                                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Итого" Style="{StaticResource PropertyLabel}"/>
                                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding TotalCost, StringFormat='{}{0:F2} руб'}" Style="{StaticResource TotalValue}"/>
                                    </Grid>

                                    <!-- Операции изготовления -->
                                    <StackPanel Grid.Row="2"
                                                Margin="0,16,0,0"
                                                Visibility="{Binding HasOperations, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Операции изготовления"
                                                   Style="{StaticResource SectionHeaderStyle}"
                                                   Margin="0,0,0,8"/>

                                        <ItemsControl ItemsSource="{Binding Operations}"
                                                      Background="Transparent"
                                                      BorderThickness="0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                <!-- ПРАВАЯ ПАНЕЛЬ: Листовой прокат, Трубный прокат, Стандартные изделия -->
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Листовой прокат -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="8,10">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="4,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Листовой" Style="{StaticResource SectionHeaderStyle}"/>
                                <ComboBox Grid.Column="1"
                                          SelectedValue="{Binding SheetMaterialsSortType, Mode=TwoWay}"
                                          Style="{StaticResource SortComboBoxStyle}"
                                          MinWidth="28"
                                          MaxWidth="110"
                                          HorizontalAlignment="Right"
                                          Margin="4,0"
                                          ToolTip="Выберите тип сортировки">
                                    <models:MaterialSortType>ByName</models:MaterialSortType>
                                    <models:MaterialSortType>ByMass</models:MaterialSortType>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource MaterialSortTypeConverter}}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2"
                                        Content="&#xE8C8;"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding CopySheetToClipboardCommand}"
                                        ToolTip="Копировать в Excel"/>
                            </Grid>
                            <ListBox ItemsSource="{Binding SheetMaterialsView}"
                                     SelectedItem="{Binding SelectedSheetMaterial}"
                                     SelectionMode="Single"
                                     PreviewMouseDown="SheetMaterialsListBox_PreviewMouseDown"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Cursor="Hand">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TotalMass, StringFormat='{}{0:F2} кг'}" FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialListBoxItemStyle}"/>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Трубный прокат -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="8,10">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="4,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Трубный" Style="{StaticResource SectionHeaderStyle}"/>
                                <ComboBox Grid.Column="1"
                                          SelectedValue="{Binding TubularProductsSortType, Mode=TwoWay}"
                                          Style="{StaticResource SortComboBoxStyle}"
                                          MinWidth="28"
                                          MaxWidth="110"
                                          HorizontalAlignment="Right"
                                          Margin="4,0"
                                          ToolTip="Выберите тип сортировки">
                                    <models:MaterialSortType>ByLength</models:MaterialSortType>
                                    <models:MaterialSortType>ByMass</models:MaterialSortType>
                                    <models:MaterialSortType>ByName</models:MaterialSortType>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource MaterialSortTypeConverter}}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2"
                                        Content="&#xE8C8;"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding CopyTubularProductsToClipboardCommand}"
                                        ToolTip="Копировать в Excel"/>
                            </Grid>
                            <ListBox ItemsSource="{Binding TubularProductsView}"
                                     SelectedItem="{Binding SelectedTubularProduct}"
                                     SelectionMode="Single"
                                     PreviewMouseDown="TubularProductsListBox_PreviewMouseDown"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Cursor="Hand">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TotalLength, StringFormat='{}{0:F2} мм'}" FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialListBoxItemStyle}"/>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.ColumnSpan="2" Background="Transparent"/>

                    <!-- Прочие материалы -->
                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="8,10">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="4,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Прочие" Style="{StaticResource SectionHeaderStyle}"/>
                                <ComboBox Grid.Column="1"
                                          SelectedValue="{Binding OtherMaterialsSortType, Mode=TwoWay}"
                                          Style="{StaticResource SortComboBoxStyle}"
                                          MinWidth="28"
                                          MaxWidth="110"
                                          HorizontalAlignment="Right"
                                          Margin="4,0"
                                          ToolTip="Выберите тип сортировки">
                                    <models:MaterialSortType>ByName</models:MaterialSortType>
                                    <models:MaterialSortType>ByMass</models:MaterialSortType>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource MaterialSortTypeConverter}}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2"
                                        Content="&#xE8C8;"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding CopyOtherMaterialsToClipboardCommand}"
                                        ToolTip="Копировать в Excel"/>
                            </Grid>
                            <ListBox ItemsSource="{Binding OtherMaterialsView}"
                                     SelectedItem="{Binding SelectedTubularProduct}"
                                     SelectionMode="Single"
                                     PreviewMouseDown="TubularProductsListBox_PreviewMouseDown"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Cursor="Hand">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TotalMass, StringFormat='{}{0:F2} кг'}" FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialListBoxItemStyle}"/>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Стандартные изделия -->
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="8,10">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="4,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Покупные" Style="{StaticResource SectionHeaderStyle}"/>
                                <Button Grid.Column="1"
                                        Content="&#xE8C8;"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding CopyStandartPartsToClipboardCommand}"
                                        ToolTip="Копировать в Excel"/>
                            </Grid>
                            <ListBox ItemsSource="{Binding StandardPartsView}"
                                     SelectedItem="{Binding SelectedStandardPart}"
                                     ItemTemplate="{StaticResource PartItemTemplate}"
                                     ItemContainerStyle="{StaticResource PartListBoxItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.GroupStyle>
                                    <GroupStyle ContainerStyle="{StaticResource GroupedContainerStyle}"/>
                                </ListBox.GroupStyle>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Индикатор загрузки -->
                <Grid Grid.ColumnSpan="5"
                      Background="#B3F3F4F6"
                      Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Style="{StaticResource CardStyle}"
                            Padding="24,18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Effect="{StaticResource SoftShadow}">
                        <StackPanel>
                            <TextBlock Text="Загрузка..." Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Center"/>
                            <ProgressBar IsIndeterminate="True"
                                         Width="200" Height="4"
                                         Margin="0,12,0,0"
                                         BorderThickness="0"
                                         Background="{StaticResource BorderColor}"
                                         Foreground="{StaticResource AccentColor}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Затемнение фона при открытой панели -->
            <Border x:Name="ProductsPanelOverlay"
                    Background="#4D111827"
                    Visibility="Collapsed"
                    Opacity="0"
                    MouseDown="OverlayBackground_MouseDown"/>

            <!-- Выдвижная панель продуктов (overlay) -->
            <Border x:Name="ProductsPanel"
                    Background="{StaticResource PrimaryBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,1,0"
                    HorizontalAlignment="Left"
                    Width="320"
                    Visibility="Collapsed"
                    RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <TranslateTransform X="-320"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" Opacity="0.15" BlurRadius="20"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок панели -->
                    <Grid Grid.Row="0" Margin="16,14,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Сохранённые изделия"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="&#xE711;"
                                Style="{StaticResource IconButton}"
                                Command="{Binding ToggleProductsPanelCommand}"
                                ToolTip="Закрыть"/>
                    </Grid>

                    <!-- Настройка серверной папки -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="16,6,16,12">
                        <StackPanel>
                            <TextBlock Text="Серверная папка"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{StaticResource SecondaryBackground}"
                                        BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,5"
                                        ToolTip="{Binding ServerStorageFolder}">
                                    <TextBlock Text="{Binding ServerStorageFolderDisplay}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                                    <Button Command="{Binding SelectServerStorageFolderCommand}"
                                            ToolTip="Выбрать серверную папку"
                                            Style="{StaticResource CopyButtonStyle}"
                                            Content="&#xE8B7;"/>
                                    <Button Command="{Binding ClearServerStorageFolderCommand}"
                                            ToolTip="Очистить"
                                            Style="{StaticResource CopyButtonStyle}"
                                            Content="&#xE711;"
                                            FontSize="10"
                                            Visibility="{Binding HasServerStorageFolder, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Синхронизация и состояние сервера -->
                            <Grid Margin="0,8,0,0"
                                  Visibility="{Binding HasServerStorageFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Индикатор состояния сервера -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Success}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsServerAvailable}" Value="False">
                                                        <Setter Property="Fill" Value="{StaticResource Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Сервер доступен"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsServerAvailable}" Value="False">
                                                        <Setter Property="Text" Value="Сервер недоступен"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Кнопка синхронизации -->
                                <Button Grid.Column="1"
                                        Command="{Binding SyncFromServerCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,4"
                                        ToolTip="Двусторонняя синхронизация: обновляет изделия в обе стороны (локально ↔ сервер)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Синхронизировать" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Список сохранённых продуктов -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding SavedProducts}"
                             SelectedItem="{Binding SelectedSavedProduct}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="8,6">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    CornerRadius="6">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBackground}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBackground}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.SwitchToProductCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </Grid.InputBindings>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ProductName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource SelectedForeground}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Marking}"
                                                   FontSize="11"
                                                   Margin="0,1,0,0"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock FontSize="10"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextMuted}">
                                            <Run Text="{Binding DetailsCount, StringFormat='{}{0} дет.', Mode=OneWay}"/>
                                            <Run Text="·"/>
                                            <Run Text="{Binding SavedDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}', Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                        <!-- Кнопка удаления локально -->
                                        <Button PreviewMouseDown="DeleteProductLocal_PreviewMouseDown"
                                                Panel.ZIndex="1"
                                                DataContext="{Binding}"
                                                ToolTip="Удалить локально"
                                                Style="{StaticResource DangerIconButton}">
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" IsHitTestVisible="False"/>
                                        </Button>
                                        <!-- Кнопка удаления локально и с сервера -->
                                        <Button PreviewMouseDown="DeleteProductEverywhere_PreviewMouseDown"
                                                Panel.ZIndex="1"
                                                DataContext="{Binding}"
                                                ToolTip="Удалить локально и с сервера"
                                                Style="{StaticResource DangerIconButton}"
                                                Width="Auto"
                                                Padding="7,0"
                                                Margin="2,0,0,0"
                                                Visibility="{Binding DataContext.HasServerStorageFolder, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" Margin="0,0,3,0"/>
                                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Всплывающая панель выбора загрузки -->
        <Popup x:Name="LoadOptionsPopup"
               PlacementTarget="{Binding ElementName=LoadDocumentButton}"
               Placement="Bottom"
               HorizontalOffset="-8"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{StaticResource PrimaryBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4"
                    Margin="8,4,8,12"
                    Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <Button Click="LoadFromKompas_Click"
                            Style="{StaticResource PanelButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71B;" Style="{StaticResource IconText}" Margin="0,0,10,0"/>
                            <TextBlock Text="Загрузить из активного КОМПАС"/>
                        </StackPanel>
                    </Button>
                    <Button Click="SelectFile_Click"
                            Style="{StaticResource PanelButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" Style="{StaticResource IconText}" Margin="0,0,10,0"/>
                            <TextBlock Text="Выбрать файл..."/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Статус-бар -->
        <Border Grid.Row="2" Background="{StaticResource PrimaryBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- Popup превью чертежа -->
        <Grid x:Name="DrawingPopupOverlay"
              Grid.Row="0" Grid.RowSpan="3"
              Visibility="Collapsed"
              Panel.ZIndex="100">
            <!-- Затемнение фона -->
            <Border Background="#B3111827"
                    MouseLeftButtonDown="DrawingPopupOverlay_MouseLeftButtonDown"/>
            <!-- Контент превью -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                  MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                  MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                  Margin="40">
                <Border Background="{StaticResource PrimaryBackground}"
                        CornerRadius="10"
                        Padding="16,12,16,16"
                        MouseLeftButtonDown="DrawingPopupContent_MouseLeftButtonDown">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="4" Direction="270" Opacity="0.25" BlurRadius="24"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок с кнопкой закрытия -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock x:Name="DrawingPopupTitle"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,40,0"/>
                            <Button Content="&#xE711;"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Закрыть (Esc)"
                                    Click="DrawingPopupClose_Click"/>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource SecondaryBackground}" CornerRadius="6">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Image x:Name="DrawingPopupImage"
                                       Stretch="None"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="20"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- SnackBar уведомление -->
        <Border x:Name="SnackbarNotification"
                Grid.Row="0" Grid.RowSpan="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Background="{StaticResource DarkSurface}"
                CornerRadius="8"
                Padding="16,10,20,10"
                Visibility="{Binding IsSnackbarVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                RenderTransformOrigin="0.5,1">
            <Border.RenderTransform>
                <TranslateTransform Y="100"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect ShadowDepth="4" Direction="270" Opacity="0.25" BlurRadius="16"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource Success}" CornerRadius="10" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="10" Foreground="White"/>
                </Border>
                <TextBlock Text="{Binding SnackbarMessage}"
                          FontSize="12"
                          Foreground="White"
                          VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
