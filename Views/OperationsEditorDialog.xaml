<Window x:Class="TankManager.Views.OperationsEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TankManager.Core.Models"
        xmlns:app="clr-namespace:TankManager"
        Title="Операции изготовления"
        Width="640" Height="620"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        FontSize="12"
        Foreground="{StaticResource TextPrimary}"
        Background="{StaticResource WindowBackground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <app:DecimalTextConverter x:Key="DecimalText"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,14,6"/>
            <EventSetter Event="GotKeyboardFocus" Handler="NumberBox_GotKeyboardFocus"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="NumberBox_PreviewMouseLeftButtonDown"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="Введите число, например 12,5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Параметры по типу операции (выбираются по DataType в ContentControl) -->
        <DataTemplate DataType="{x:Type models:LaserCuttingOperation}">
            <WrapPanel>
                <TextBlock Text="Рез, мм" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}"
                         Text="{Binding CutLength, Converter={StaticResource DecimalText}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                <TextBlock Text="Гравировка, мм" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}"
                         Text="{Binding EngravingLength, Converter={StaticResource DecimalText}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
            </WrapPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:BendingOperation}">
            <WrapPanel>
                <TextBlock Text="Угол, °" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}"
                         Text="{Binding BendAngle, Converter={StaticResource DecimalText}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                <TextBlock Text="Длина, мм" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}"
                         Text="{Binding BendLength, Converter={StaticResource DecimalText}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
            </WrapPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:FlangingOperation}">
            <WrapPanel>
                <TextBlock Text="Радиус, мм" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}"
                         Text="{Binding Radius, Converter={StaticResource DecimalText}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                <TextBlock Text="Ø, мм" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}"
                         Text="{Binding Diameter, Converter={StaticResource DecimalText}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
            </WrapPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:RollingOperation}">
            <TextBlock Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6">
                <Run Text="Стоимость по массе детали:"/>
                <Run Text="{Binding PartMass, Mode=OneWay, StringFormat='{}{0:N2} кг'}"/>
            </TextBlock>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:CustomOperation}">
            <WrapPanel>
                <TextBlock Text="Название" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}" Width="180"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Цена за шт., ₽" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}"
                         Text="{Binding UnitPrice, Converter={StaticResource DecimalText}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
            </WrapPanel>
        </DataTemplate>

        <!-- Карточка операции: общая часть для всех типов -->
        <DataTemplate x:Key="OperationRowTemplate">
            <Border x:Name="Card" Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="TitleText" Text="{Binding TypeTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"/>
                        <Border Style="{StaticResource Badge}" Background="{StaticResource AccentSubtle}"
                                Visibility="{Binding IsManual, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="добавлена вручную" FontSize="10" Foreground="{StaticResource AccentColor}"/>
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="{StaticResource DangerSubtle}"
                                Visibility="{Binding IsExcluded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="исключена из расчёта" FontSize="10" Foreground="{StaticResource Danger}"/>
                        </Border>
                        <TextBlock Text="{Binding ChangeInfo}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>

                    <ContentControl Grid.Row="1" Content="{Binding}" Focusable="False"/>

                    <WrapPanel Grid.Row="2">
                        <TextBlock Text="Кол-во" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FieldBox}" Width="60"
                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                        <CheckBox Content="Цена вручную, ₽" VerticalAlignment="Center" Margin="0,0,6,6"
                                  IsChecked="{Binding HasManualCost}"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 IsEnabled="{Binding HasManualCost}"
                                 Text="{Binding ManualCost, Converter={StaticResource DecimalText}, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Grid.RowSpan="3" VerticalAlignment="Top" Margin="12,0,0,0">
                        <TextBlock Text="{Binding Cost, StringFormat='{}{0:N2} ₽'}" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" Margin="0,0,0,8"/>
                        <Button x:Name="RemoveButton" Content="Удалить" Tag="{Binding}" Click="RemoveOperation_Click"
                                Style="{StaticResource SecondaryButton}" MinWidth="90" Height="28"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsManual}" Value="False">
                    <Setter TargetName="RemoveButton" Property="Content" Value="Исключить"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                    <Setter TargetName="RemoveButton" Property="Content" Value="Вернуть"/>
                    <Setter TargetName="Card" Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="4,0,0,12">
            <TextBlock x:Name="PartTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="InstancesNote" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource TextMuted}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="AddButton" Content="Добавить операцию ▾" Click="AddButton_Click"
                    Style="{StaticResource SecondaryButton}" MinWidth="150" Height="30" Margin="0,0,8,0">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Прочая операция (сварка, зачистка…)" Tag="Custom" Click="AddOperation_Click"/>
                        <Separator/>
                        <MenuItem Header="Резка на лазере" Tag="LaserCutting" Click="AddOperation_Click"/>
                        <MenuItem Header="Гибка" Tag="Bending" Click="AddOperation_Click"/>
                        <MenuItem Header="Вальцовка" Tag="Rolling" Click="AddOperation_Click"/>
                        <MenuItem Header="Отбортовка" Tag="Flanging" Click="AddOperation_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Content="Сбросить правки" Click="ResetButton_Click"
                    ToolTip="Убрать добавленные вручную операции и вернуть операции из КОМПАС к исходным значениям"
                    Style="{StaticResource SecondaryButton}" MinWidth="130" Height="30"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="OperationsList" ItemTemplate="{StaticResource OperationRowTemplate}"/>
            </ScrollViewer>
            <TextBlock x:Name="EmptyNote" Text="Операций нет. Добавьте операцию кнопкой выше."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource TextMuted}" Visibility="Collapsed"/>
        </Grid>

        <!-- Итог и кнопки -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Отмена" IsCancel="True" Click="CancelButton_Click"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="90" Height="32" Margin="0,0,8,0"/>
                <Button Content="Сохранить" IsDefault="True" Click="SaveButton_Click"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="110" Height="32"/>
            </StackPanel>
            <TextBlock x:Name="TotalText" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="4,0,0,0"/>
        </DockPanel>
    </Grid>
</Window>
