<Window x:Class="TankManager.Views.AuditLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал изменений"
        Width="1000" Height="640"
        MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        FontSize="12"
        Foreground="{StaticResource TextPrimary}"
        Background="{StaticResource WindowBackground}">
    <Window.Resources>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="SelectedValuePath" Value="Key"/>
            <Setter Property="DisplayMemberPath" Value="Value"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Журнал изменений" FontSize="16" FontWeight="SemiBold" Margin="4,0,0,12"/>

        <!-- Фильтры -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Изделие" Style="{StaticResource FilterLabel}"/>
            <TextBox x:Name="ProductFilterBox" Style="{StaticResource ModernTextBox}" Width="200" Height="28" Margin="0,0,14,0"
                     TextChanged="Filter_Changed" ToolTip="Часть названия или обозначения изделия"/>
            <TextBlock Text="Сотрудник" Style="{StaticResource FilterLabel}"/>
            <ComboBox x:Name="UserFilter" Style="{StaticResource FilterCombo}" Width="180" SelectionChanged="Filter_Changed"/>
            <TextBlock Text="Действие" Style="{StaticResource FilterLabel}"/>
            <ComboBox x:Name="ActionFilter" Style="{StaticResource FilterCombo}" Width="170" SelectionChanged="Filter_Changed"/>
            <TextBlock Text="Период" Style="{StaticResource FilterLabel}"/>
            <ComboBox x:Name="PeriodFilter" Style="{StaticResource FilterCombo}" Width="130" SelectionChanged="Filter_Changed"/>
        </WrapPanel>

        <Grid Grid.Row="2">
            <DataGrid x:Name="EntriesGrid" Style="{StaticResource ListGrid}" IsReadOnly="True"
                      SelectionChanged="EntriesGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Когда" Width="115" Binding="{Binding LocalTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"/>
                    <DataGridTextColumn Header="Сотрудник" Width="150" Binding="{Binding UserDisplayName}"/>
                    <DataGridTextColumn Header="Действие" Width="140" Binding="{Binding ActionTitle}"/>
                    <DataGridTextColumn Header="Изделие" Width="*" Binding="{Binding ProductDisplay}"/>
                    <DataGridTextColumn Header="Деталь" Width="*" Binding="{Binding PartDisplay}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="StatusText" Text="Загрузка журнала..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource TextMuted}"/>
        </Grid>

        <!-- Подробности выбранной записи -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,10,0,0" MaxHeight="180">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="DetailsText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         TextWrapping="Wrap" FontFamily="Consolas, Segoe UI" FontSize="12"
                         Text="Выберите запись, чтобы увидеть, что изменилось"/>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Закрыть" IsCancel="True" IsDefault="True" Click="CloseButton_Click"
                    Style="{StaticResource SecondaryButton}" MinWidth="90" Height="32"/>
            <Button DockPanel.Dock="Right" Content="Обновить" Click="RefreshButton_Click"
                    Style="{StaticResource SecondaryButton}" MinWidth="90" Height="32" Margin="0,0,8,0"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="4,0,0,0"/>
        </DockPanel>
    </Grid>
</Window>
