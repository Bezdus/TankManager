<Window x:Class="TankManager.Views.PricingSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TankManager.Views"
        xmlns:app="clr-namespace:TankManager"
        Title="Настройки расценок"
        Width="520" Height="760"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        FontSize="12"
        Foreground="{StaticResource TextPrimary}"
        Background="{StaticResource WindowBackground}">
    <Window.Resources>
        <app:DecimalTextConverter x:Key="DecimalText"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <EventSetter Event="GotKeyboardFocus" Handler="NumberBox_GotKeyboardFocus"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="NumberBox_PreviewMouseLeftButtonDown"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="Введите число, например 12,5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Таблицы цен (трубный прокат, лазерная резка по толщине) -->
        <Style x:Key="PriceGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="True"/>
            <Setter Property="CanUserDeleteRows" Value="True"/>
            <Setter Property="MaxHeight" Value="160"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="{StaticResource PrimaryBackground}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource SecondaryBackground}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource SelectedBackground}"/>
                                <Setter Property="Foreground" Value="{StaticResource SelectedForeground}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="4,0,0,12">
            <TextBlock Text="Расценки для расчёта стоимости деталей"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock x:Name="ReadOnlyNote"
                       Text="Режим просмотра: расценки общие для всех и меняются конструктором"
                       FontSize="11" Margin="0,4,0,0"
                       Foreground="{StaticResource TextMuted}"
                       Visibility="Collapsed"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Секция: Металл -->
                <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Металл" Style="{StaticResource CardTitle}"/>

                        <!-- Листовой прокат -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Листовой прокат (руб/кг)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource FieldBox}"
                                     Text="{Binding SheetMetalPricePerKg, Converter={StaticResource DecimalText}}"/>
                        </Grid>

                        <!-- Прочий металл -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Прочий металл (руб/кг)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource FieldBox}"
                                     Text="{Binding OtherMetalPricePerKg, Converter={StaticResource DecimalText}}"/>
                        </Grid>

                        <!-- Трубный прокат -->
                        <TextBlock Text="Трубный прокат (руб/м)" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>

                        <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6">
                            <DataGrid x:Name="TubularGrid" Style="{StaticResource PriceGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Сортамент (подстрока)" Width="*"
                                                        Binding="{Binding Size}"/>
                                    <DataGridTextColumn Header="Цена (руб/м)" Width="120"
                                                        Binding="{Binding PricePerMeter, Converter={StaticResource DecimalText}}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <TextBlock Text="Подстрока ищется в наименовании материала (например: 104x2)"
                                   FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </Border>

                <!-- Секция: Операции -->
                <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Операции" Style="{StaticResource CardTitle}"/>

                        <!-- Лазерная резка по толщине листа -->
                        <TextBlock Text="Резка на лазере по толщине листа (руб/м)" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>

                        <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6">
                            <DataGrid x:Name="LaserGrid" Style="{StaticResource PriceGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Толщина листа (мм)" Width="*"
                                                        Binding="{Binding Thickness, Converter={StaticResource DecimalText}}"/>
                                    <DataGridTextColumn Header="Цена (руб/м)" Width="120"
                                                        Binding="{Binding PricePerMeter, Converter={StaticResource DecimalText}}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <TextBlock Text="Толщина берётся из наименования материала (Лист 3 ГОСТ… → 3)"
                                   FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>

                        <!-- Лазерная резка: прочие толщины -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Резка, прочие толщины (руб/м)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource FieldBox}"
                                     Text="{Binding LaserCuttingPricePerMeter, Converter={StaticResource DecimalText}}"/>
                        </Grid>

                        <!-- Гравировка -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Гравировка (руб/мм)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource FieldBox}"
                                     Text="{Binding EngravingPricePerMm, Converter={StaticResource DecimalText}}"/>
                        </Grid>

                        <!-- Гибка -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Гибка (руб/операция)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource FieldBox}"
                                     Text="{Binding BendingPricePerOperation, Converter={StaticResource DecimalText}}"/>
                        </Grid>

                        <!-- Вальцовка -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Вальцовка (руб/кг)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource FieldBox}"
                                     Text="{Binding RollingPricePerKg, Converter={StaticResource DecimalText}}"/>
                        </Grid>

                        <!-- Отбортовка -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Отбортовка (руб/операция)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource FieldBox}"
                                     Text="{Binding FlangingPricePerOperation, Converter={StaticResource DecimalText}}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Отмена" IsCancel="True" Click="CancelButton_Click"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="90" Height="32" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="Сохранить" IsDefault="True" Click="SaveButton_Click"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="110" Height="32"/>
        </StackPanel>
    </Grid>
</Window>
